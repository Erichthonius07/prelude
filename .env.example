# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# --- Postgres ---
POSTGRES_DB=burst_denoise
POSTGRES_USER=burst_admin
POSTGRES_PASSWORD=change_me_locally

# --- Results Service (Spring Boot) ---
# Must match the Postgres values above — Spring reads these at container start.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/burst_denoise
SPRING_DATASOURCE_USERNAME=burst_admin
SPRING_DATASOURCE_PASSWORD=change_me_locally

# Port the Results Service is reachable on from the host / Android devices on the same Wi-Fi
RESULTS_SERVICE_PORT=8080

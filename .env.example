# PostgreSQL (single source of truth for the DB name)
POSTGRES_DB=prelude
POSTGRES_USER=prelude
POSTGRES_PASSWORD=change-me

# Results service
# Placeholder admin token for held-out manifest mutation endpoints (POST /api/v1/testset/images).
# Real auth mechanism is an open question — see docs/data-contract.md §8.
RESULTS_ADMIN_TOKEN=change-me-too
# Host port for the results service UI/API (container always listens on 8080).
# Override only if 8080 is taken on your machine (e.g. RESULTS_PORT=8081).
# RESULTS_PORT=8080
